# Madmail Docker Compose settings. Copy to .env next to compose.yaml and edit.
# Values are only used by the first `bootstrap` run unless noted otherwise;
# after /etc/madmail/madmail.conf exists, edit that file (or use the madmail
# CLI / admin API) instead.

# Image to run (pin a version for production, e.g. ghcr.io/themadorg/madmail:2.39.1).
MADMAIL_IMAGE=ghcr.io/themadorg/madmail:latest

# REQUIRED: public IP address clients and other servers reach. Used for TURN
# (calls), Iroh and client setup hints.
MADMAIL_PUBLIC_IP=203.0.113.50

# Mail domain. Leave empty for an IP-only relay (addresses look like
# user@[203.0.113.50] and TLS is self-signed).
MADMAIL_DOMAIN=
# Server hostname (TLS name, SMTP banner). Defaults to MADMAIL_DOMAIN.
MADMAIL_HOSTNAME=

# TLS mode: empty = install default (autocert for a domain, self_signed for an IP),
# or one of: autocert | self_signed | file
MADMAIL_TLS_MODE=
# Let's Encrypt account email (defaults to admin@<domain> when empty).
MADMAIL_ACME_EMAIL=

# UI language: en | fa | ru | es
MADMAIL_LANG=en
# Enable the Iroh relay for WebXDC realtime (TCP 3340).
MADMAIL_ENABLE_IROH=false
# Extra flags appended to `madmail install` (whitespace separated).
MADMAIL_INSTALL_EXTRA_ARGS=

# Host paths for state and config (used on every run).
MADMAIL_STATE_DIR=/var/lib/madmail
MADMAIL_CONFIG_DIR=/etc/madmail

# Host address to publish ports on (bridged networking only).
MADMAIL_BIND_IP=0.0.0.0
# TURN relay UDP range to publish (bridged networking only). Must match the
# relay_port_min / relay_port_max range madmail uses (default 49152-65535).
MADMAIL_TURN_RELAY_PORTS=49152-65535

MADMAIL_CONTAINER_NAME=madmail
