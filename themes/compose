#!/usr/bin/env python3
"""Compose a Madmail theme variant from the authored flavour sources in src/.

A variant is the 4-tuple (site flavour, app flavour, site mode, app mode).
This script only ever sets two declarations and the attribution line --
it never reads or writes a colour.
"""
import re, sys, os

DIR = (os.environ.get("MADMAIL_THEMES_DIR")
       or os.path.dirname(os.path.realpath(__file__)))
SRC = os.path.join(DIR, "src")
FAMILIES = ("millennium", "frontier", "primer")

# variant suffix -> (site flavour is soft, app flavour is soft, site mode, app mode)
TABLE = {
    "dark":                (False, False, "dark",  "dark"),
    "dark-mix":            (False, True,  "dark",  "dark"),
    "dark-mix-light":      (False, False, "dark",  "light"),
    "dark-soft":           (True,  True,  "dark",  "dark"),
    "dark-soft-mix":       (True,  False, "dark",  "dark"),
    "dark-soft-mix-light": (True,  True,  "dark",  "light"),
    "light":               (False, False, "light", "light"),
    "light-soft":          (True,  True,  "light", "light"),
    "light-mix":           (False, False, "light", "dark"),
    "light-soft-mix":      (True,  True,  "light", "dark"),
}

def parse(variant):
    for fam in FAMILIES:
        if not variant.startswith(fam + "-"):
            continue
        suffix = variant[len(fam) + 1:]
        if suffix in TABLE:
            s_soft, a_soft, s_mode, a_mode = TABLE[suffix]
            return (fam + ("-soft" if s_soft else ""),
                    fam + ("-soft" if a_soft else ""), s_mode, a_mode)
    return None

def set_decl(block, name, value, indent="  "):
    pat = re.compile(r"([ \t]*)" + re.escape(name) + r":[^;]*;")
    if pat.search(block):
        return pat.sub(lambda m: m.group(1) + name + ": " + value + ";", block, count=1)
    return "\n" + indent + name + ": " + value + ";" + block

def inject(text, selector, name, value, label):
    m = re.search(selector, text, re.M)
    if not m:
        sys.exit("compose: block %s not found in %s" % (selector, label))
    a, b = m.end(), text.index("}", m.end())
    return text[:a] + set_decl(text[a:b], name, value) + text[b:]

def attribute(text, variant, label):
    t, n = re.subn(r"(?m)^( \* )Madmail (?:theme|flavour): .*$",
                   lambda m: m.group(1) + "Madmail theme: " + variant, text)
    if n != 1:
        sys.exit("compose: expected 1 attribution line in %s, found %d" % (label, n))
    return t

def main():
    if len(sys.argv) != 3:
        sys.exit("usage: compose <variant> <outdir>")
    variant, out = sys.argv[1], sys.argv[2]
    p = parse(variant)
    if not p:
        sys.exit("compose: unknown variant: %s" % variant)
    s_fl, a_fl, s_mode, a_mode = p

    sp = os.path.join(SRC, s_fl + ".main.css")
    ap = os.path.join(SRC, a_fl + ".app.css")
    site = open(sp, encoding="utf-8").read()
    app  = open(ap, encoding="utf-8").read()

    for t, lbl in ((site, sp), (app, ap)):
        if re.search(r":[ \t]*__", t):
            sys.exit("compose: unfilled placeholder in %s" % lbl)

    # site: the LIGHT :root always applies and is read before the head script
    # adds .dark, so the declaration belongs there
    site = inject(site, r"^:root \{", "--default-mode", s_mode, sp)
    # app: :root likewise always applies (.light only when the class is set),
    # matching how the existing light app files already declare it
    app  = inject(app,  r"^:root \{", "--dc-default-mode", a_mode, ap)

    site = attribute(site, variant, sp)
    app  = attribute(app,  variant, ap)

    os.makedirs(out, exist_ok=True)
    open(os.path.join(out, "main.css"), "w", encoding="utf-8").write(site)
    open(os.path.join(out, "app.css"),  "w", encoding="utf-8").write(app)
    print("composed %-30s site=%-16s (%-5s)  app=%-16s (%-5s)"
          % (variant, s_fl, s_mode, a_fl, a_mode))

if __name__ == "__main__":
    main()
